# Installed as /etc/family-menu.env on the server. Never commit real secrets.
APP_ENV=development
PUSH_ENABLED=false
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
OWNER_AUTH_USERNAME=CHANGE_ME_OWNER
WORKER_AUTH_USERNAME=CHANGE_ME_WORKER
H5_BASE_URL=https://CHANGE_ME
FAMILY_MENU_DB_PATH=/opt/family-menu/data/family_menu.db
PHOTO_DIR=/opt/family-menu/photos
HOST=127.0.0.1
MAX_UPLOAD_BYTES=8388608
BACKUP_DIR=/opt/family-menu/backups
BACKUP_RETENTION=14
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_COMMAND=CHANGE_ME {artifact}
