[Unit]
Description=Family Menu daily photos archive
After=local-fs.target
RequiresMountsFor=/opt/family-menu/photos /opt/family-menu/backups

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/family-menu/app
EnvironmentFile=/etc/family-menu.env
UMask=0077
ExecStart=/usr/bin/env BACKUP_DIR=/opt/family-menu/backups/photos-daily BACKUP_RETENTION=7 /usr/bin/python3 /opt/family-menu/app/backup_data.py photos
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/family-menu/backups
