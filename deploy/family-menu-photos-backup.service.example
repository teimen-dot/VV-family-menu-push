[Unit]
Description=Family Menu Weekly Photo Archive
After=family-menu-admin.service

[Service]
Type=oneshot
User=family-menu
Group=family-menu
WorkingDirectory=/opt/family-menu/app
EnvironmentFile=/etc/family-menu.env
ExecStart=/usr/bin/python3 /opt/family-menu/app/backup_data.py photos
UMask=0027
NoNewPrivileges=true
StandardOutput=append:/opt/family-menu/logs/backup.log
StandardError=append:/opt/family-menu/logs/backup.log
